---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Page not found · Alex" description="That page is not on this site.">
  <main class="narrow missing">
    <p class="kicker">404</p>
    <h1>That page is not here.</h1>
    <p class="lede">The writeups, the music, and the contact form are all on the homepage.</p>
    <p><a class="button" href={base}>Back home</a></p>
  </main>
</Base>
