---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WriteupCard from '../components/WriteupCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { githubUrl, musicLinks, spotify } from '../config';

const writeups = (await getCollection('writeups')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Alex · N3TV01D"
  description="Writeups from Alex, an aspiring ethical hacker in the Netherlands. Hardware, a homelab, and local AI."
>
  <main>
    <section class="hero" id="top">
      <div class="container hero-grid">
        <div>
          <p class="kicker">N3TV01D · Netherlands</p>
          <h1>Alex</h1>
          <p class="role">Aspiring ethical hacker</p>
          <p class="lede">
            I build labs, take hardware apart, and write down what I learn. This is the work I want to do professionally.
          </p>
          <div class="hero-actions">
            <a class="button" href="#contact">Contact</a>
            <a class="text-link" href={githubUrl}>GitHub</a>
          </div>
        </div>
        <dl class="hero-facts">
          <div>
            <dt>Focus</dt>
            <dd>Labs, hardware, and notes</dd>
          </div>
          <div>
            <dt>Events</dt>
            <dd>HACK.FRL, CONNECT.FRL</dd>
          </div>
          <div>
            <dt>Also</dt>
            <dd>Music, released as Laced</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="band" id="writeups">
      <div class="container">
        <h2 class="sr-only">Writeups</h2>
        <ul class="writeup-grid">
          {writeups.map((writeup) => <li><WriteupCard writeup={writeup} /></li>)}
        </ul>
      </div>
    </section>

    <section class="band band-raise" id="music">
      <div class="container split">
        <div>
          <h2>Laced</h2>
          <p>
            I make music in my free time under the name Laced. Most of it is dubstep, written in FL Studio, usually in long sessions that turn into too many project files.
          </p>
          <p>
            The lab exists partly because of this. Renders and project files stay on my own machines. When a track is finished it goes out as Laced. Mechanical Mayhem is the latest release, and the player is the Spotify profile.
          </p>
          <div class="link-row">
            {
              musicLinks.map((link) => (
                <a class="text-link" href={link.href} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
        <div class="player">
          <iframe
            title="Laced on Spotify"
            src={spotify.embedUrl}
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section class="band" id="about">
      <div class="container about-grid">
        <div class="about-copy">
          <h2>About me</h2>
          <p>Hello, my name is Alex. I am an ethical hacker and a cybersecurity enthusiast from the Netherlands.</p>
          <p>
            I am curious about anything to do with computers, and the people who know me would call that stubborn as much as curious. If a problem is unfamiliar I learn it, then I try it on something real.
          </p>
          <p>
            Most of what I know is self-taught: building PCs, Linux, flashing Android phones, and softmodding or hardmodding consoles. The first machine I fixed, I was five. We were at a friend of my mother's, and the computer in her daughter's room would not start. I opened the BIOS, underclocked the CPU and the RAM, and it came back. Her father had been trying for days.
          </p>
          <p>
            Since then the same habit has been a <a href="#writeups">homelab</a>: storage, a VPN, a media server, and a model that runs in the house. I am not planning to stop learning this.
          </p>
          <p>I also go to a lot of lectures on cybersecurity, on top of the events listed here.</p>
        </div>
        <aside class="events">
          <h3>Events</h3>
          <ul>
            <li>
              <strong>HACK.FRL</strong>
              <span>3 March 2026</span>
            </li>
            <li>
              <strong>CONNECT.FRL</strong>
              <span>25 March 2026</span>
            </li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="band band-raise" id="contact">
      <div class="container contact-grid">
        <div class="contact-copy">
          <h2>Contact</h2>
          <p>Hiring, a question about a writeup, or the music. Send a note with your name, an email, and what it is about.</p>
        </div>
        <ContactForm />
      </div>
    </section>
  </main>
</Base>

<script>
  const section = document.getElementById('writeups');

  if (section) {
    const moveLight = (event: PointerEvent) => {
      const bounds = section.getBoundingClientRect();
      section.style.setProperty('--glow-x', `${event.clientX - bounds.left}px`);
      section.style.setProperty('--glow-y', `${event.clientY - bounds.top}px`);
      section.classList.add('is-lit');
    };

    section.addEventListener('pointerenter', moveLight);
    section.addEventListener('pointermove', moveLight);
    section.addEventListener('pointerleave', () => section.classList.remove('is-lit'));

    section.addEventListener('focusin', (event) => {
      const card = event.target instanceof Element ? event.target.closest('.card') : null;
      if (!(card instanceof HTMLElement)) return;
      const bounds = section.getBoundingClientRect();
      const cardBounds = card.getBoundingClientRect();
      section.style.setProperty('--glow-x', `${cardBounds.left + cardBounds.width / 2 - bounds.left}px`);
      section.style.setProperty('--glow-y', `${cardBounds.top + cardBounds.height / 2 - bounds.top}px`);
      section.classList.add('is-lit');
    });

    section.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (!(next instanceof Node) || !section.contains(next)) section.classList.remove('is-lit');
    });
  }
</script>
