---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WriteupCard from '../components/WriteupCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { githubUrl, musicLinks, spotify } from '../config';

const writeups = (await getCollection('writeups')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Alex · N3TV01D"
  description="Writeups from Alex, an aspiring ethical hacker in the Netherlands. Hardware, a homelab, and local AI."
>
  <main>
    <section class="hero" id="top">
      <div class="container hero-grid">
        <div>
          <p class="kicker">N3TV01D · Netherlands</p>
          <h1>Alex</h1>
          <p class="role">Ethical Hacker</p>
          <p class="lede">
            I build stuff, take stuff apart, and write down what I learn. Always learning to become better.
          </p>
          <div class="hero-actions">
            <a class="button" href="#contact">Contact</a>
            <a class="text-link" href={githubUrl}>GitHub</a>
          </div>
        </div>
        <dl class="hero-facts">
          <div>
            <dt>Focus</dt>
            <dd>Software, hardware, and Hacking</dd>
          </div>
          <div>
            <dt>Events</dt>
            <dd>HACK.FRL, CONNECT.FRL</dd>
          </div>
          <div>
            <dt>Also</dt>
            <dd>Music, released as Laced</dd>
            <dd>Learning Japanese</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="band" id="writeups">
      <div class="container">
        <h2 class="sr-only">Writeups</h2>
        <ul class="writeup-grid" id="writeup-list">
          {writeups.map((writeup) => <li><WriteupCard writeup={writeup} /></li>)}
        </ul>
        <nav class="pager" aria-label="Writeup pages" hidden>
          <button type="button" class="pager-step" data-pager="prev" aria-label="Previous page">&larr;</button>
          <ol class="pager-pages"></ol>
          <button type="button" class="pager-step" data-pager="next" aria-label="Next page">&rarr;</button>
          <p class="pager-count" aria-live="polite"></p>
        </nav>
      </div>
    </section>

    <section class="band band-raise" id="music">
      <div class="container split">
        <div>
          <h2>LACED</h2>
          <p>
            In my free time I like to make music under the name Laced. Most of it is either dubstep, techno, drum and bass or breakcore, all done in FL Studio.
          </p>
          <p>
            A part of my homelab exists because of this. Renders and project files stay on my own machines. When a track is finished it goes out as Laced. Mechanical Mayhem is one of my latest releases, but more is yet to come.
          </p>
          <p>
            Besides that I have my own label through which I upload my music. I have already made some contacts but I'd like to collaborate with more artists in the future.
          </p>
          <div class="link-row">
            {
              musicLinks.map((link) => (
                <a class="text-link" href={link.href} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
        <div class="player">
          <iframe
            title="Laced on Spotify"
            src={spotify.embedUrl}
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section class="band" id="about">
      <div class="container about-grid">
        <div class="about-copy">
          <h2>About me</h2>
          <p>Hello, my name is Alex. I am an ethical hacker and a cybersecurity enthusiast from the Netherlands.</p>
          <p>
            I am curious about anything that has to do with computers, and the people who know me would call that stubborn as much as curious. If a problem is unfamiliar with me, I learn it, then I try it on something real.
          </p>
          <p>
            Most of what I know is self-taught: building PCs, Linux, flashing Android phones, and softmodding or hardmodding consoles. The first machine I fixed was when I was five. We were at the house of a friend of my mother's, and the computer in her daughter's room would not boot. I opened the BIOS, underclocked the CPU and the RAM, and it came back. Her father had been trying for days with no success.
          </p>
          <p>
            Since then the same habit has been a <a href="#writeups">homelab</a>: storage, a VPN, a media server, and a model that runs in the house. I am not planning to stop learning any time soon.
          </p>
          <p>I also go to a lot of (online) lectures on cybersecurity, on top of the real world events listed here.</p>
        </div>
        <aside class="events">
          <h3>Events</h3>
          <ul>
            <li>
              <strong>HACK.FRL</strong>
              <span>3 March 2026</span>
            </li>
            <li>
              <strong>CONNECT.FRL</strong>
              <span>25 March 2026</span>
            </li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="band band-raise" id="contact">
      <div class="container contact-grid">
        <div class="contact-copy">
          <h2>Contact</h2>
          <p>Want to hire, a question about a writeup, or the music? Send a note with your name, an email, and what it is about.</p>
        </div>
        <ContactForm />
      </div>
    </section>
  </main>
</Base>

<script>
  const section = document.getElementById('writeups');

  const list = document.getElementById('writeup-list');
  const pager = section?.querySelector<HTMLElement>('.pager');

  if (list && pager) {
    const items = Array.from(list.children) as HTMLElement[];
    const pagesList = pager.querySelector<HTMLOListElement>('.pager-pages')!;
    const prev = pager.querySelector<HTMLButtonElement>('[data-pager="prev"]')!;
    const next = pager.querySelector<HTMLButtonElement>('[data-pager="next"]')!;
    const count = pager.querySelector<HTMLElement>('.pager-count')!;
    const phone = window.matchMedia('(max-width: 640px)');

    let page = 0;
    const perPage = () => (phone.matches ? 5 : 12);
    const totalPages = () => Math.max(1, Math.ceil(items.length / perPage()));

    const render = () => {
      const size = perPage();
      const total = totalPages();
      page = Math.min(page, total - 1);

      items.forEach((item, index) => {
        item.hidden = Math.floor(index / size) !== page;
      });

      pager.hidden = total <= 1;
      prev.disabled = page === 0;
      next.disabled = page === total - 1;

      pagesList.replaceChildren(
        ...Array.from({ length: total }, (_, index) => {
          const li = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'pager-num';
          button.textContent = String(index + 1);
          button.setAttribute('aria-label', `Page ${index + 1}`);
          if (index === page) button.setAttribute('aria-current', 'page');
          button.addEventListener('click', () => goTo(index));
          li.append(button);
          return li;
        }),
      );

      const first = page * size + 1;
      const last = Math.min(items.length, first + size - 1);
      count.textContent = `${first}–${last} of ${items.length}`;
    };

    const goTo = (target: number) => {
      if (target === page) return;
      page = target;
      render();
      const top = section!.getBoundingClientRect().top;
      if (top < 0) section!.scrollIntoView({ block: 'start' });
    };

    prev.addEventListener('click', () => goTo(page - 1));
    next.addEventListener('click', () => goTo(page + 1));
    phone.addEventListener('change', () => {
      page = 0;
      render();
    });

    render();
  }

  if (section) {
    const moveLight = (event: PointerEvent) => {
      const bounds = section.getBoundingClientRect();
      section.style.setProperty('--glow-x', `${event.clientX - bounds.left}px`);
      section.style.setProperty('--glow-y', `${event.clientY - bounds.top}px`);
      section.classList.add('is-lit');
    };

    section.addEventListener('pointerenter', moveLight);
    section.addEventListener('pointermove', moveLight);
    section.addEventListener('pointerleave', () => section.classList.remove('is-lit'));

    section.addEventListener('focusin', (event) => {
      const card = event.target instanceof Element ? event.target.closest('.card') : null;
      if (!(card instanceof HTMLElement)) return;
      const bounds = section.getBoundingClientRect();
      const cardBounds = card.getBoundingClientRect();
      section.style.setProperty('--glow-x', `${cardBounds.left + cardBounds.width / 2 - bounds.left}px`);
      section.style.setProperty('--glow-y', `${cardBounds.top + cardBounds.height / 2 - bounds.top}px`);
      section.classList.add('is-lit');
    });

    section.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (!(next instanceof Node) || !section.contains(next)) section.classList.remove('is-lit');
    });
  }
</script>
